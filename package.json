{
  "name": "trv-gestion-inmobiliaria",
  "version": "1.3.0",
  "private": true,
  "description": "PropControl MVP para gestión de leads, conversaciones y seguimientos inmobiliarios.",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build-extension-zip.mjs",
    "start": "node dist/server.js",
    "pretest": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; console.log('PRE_B1_4_4_LOCKFILE_BASE64=' + readFileSync('package-lock.json').toString('base64'))\"",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js"
  },
  "dependencies": {
    "playwright": "1.61.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "5.8.3"
  }
}
